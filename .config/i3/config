exec_always --no-startup-id ~/.config/polybar/launch.sh

title_align center
# bordes
default_border pixel 1
default_floating_border pixel 1
smart_borders on
gaps inner 6

# colores de los bordes de ventana
# class                 border  backgr. text    indicator child_border
client.focused          #131519 #222E73 #FFFFFF #00796B   #303F9F
client.unfocused        #131519 #131519 #ADADAD #00796B   #222222

# Ejecuciones al inicio
exec --no-startup-id ~/Scripts/rofi/change-wallpaper.sh apply
exec --no-startup-id lxpolkit
exec --no-startup-id setxkbmap -option esperanto:qwerty

# shortcuts
bindsym $mod+x exec rofi -show drun
bindsym $mod+d exec --no-startup-id i3-dmenu-desktop
bindsym --release $mod+b bar mode toggle
bindsym $mod+Return exec lxterminal
bindsym $mod+f exec pcmanfm
bindsym $mod+w exec gtk-launch chromium
bindsym Print exec --no-startup-id ~/Scripts/rofi/screenshoot.sh

# reglas
for_window [title="kazam"] floating enable
