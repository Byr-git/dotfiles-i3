# ~/.config/i3blocks/config

# Intervalo por defecto (en segundos) si un bloque no especifica el suyo
interval=5

[Music]
command=~/Scripts/i3blocks/music.sh
signal=15
markup=pango
separator=false

#[Network]
#command=~/i3blocks/internet.sh
#interval=10
#markup=pango
#separator=false

[CPU]
command=~/Scripts/i3blocks/scripts-c/cpu-s
interval=persist
markup=pango
separator=false

[Disk]
command=~/Scripts/i3blocks/almacenamiento.sh
interval=120
markup=pango
separator=false

[Memory]
command=~/Scripts/i3blocks/scripts-c/ram-s
interval=5
markup=pango
separator=false

[time]
command=~/Scripts/i3blocks/tiempo.sh
interval=60
markup=pango
separator=false

[Volume]
command=~/Scripts/i3blocks/volume.sh
interval=once
signal=7
markup=pango
separator=true
separator_block_width=15

[Power Off]
command=~/Scripts/i3blocks/apagar-reboot-logout.sh
interval=once
markup=pango
separator=false
