# ~/.config/i3blocks/config

# Intervalo por defecto (en segundos) si un bloque no especifica el suyo
interval=5

[Music]
command=~/.config/i3blocks/default/scripts-bash/music.sh
signal=15
markup=pango
separator=false

#[Network]
#command=~/.config/i3blocks/default/scripts-bash/internet.sh
#interval=10
#markup=pango
#separator=false

[CPU]
command=~/.config/i3blocks/default/scripts-c/cpu-s
interval=persist
markup=pango
separator=false

[Disk]
command=~/.config/i3blocks/default/scripts-bash/almacenamiento.sh
interval=120
markup=pango
separator=false

[Memory]
command=~/.config/i3blocks/default/scripts-c/ram-s
interval=5
markup=pango
separator=false

[time]
command=~/.config/i3blocks/default/scripts-bash/tiempo.sh
interval=60
markup=pango
separator=false

[Volume]
command=~/.config/i3blocks/default/scripts-bash/volume.sh
interval=once
signal=7
markup=pango
separator=true
separator_block_width=15

[Power Off]
command=~/.config/i3blocks/default/scripts-bash/apagar-reboot-logout.sh
interval=once
markup=pango
separator=false
