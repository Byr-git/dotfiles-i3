# ~/.config/i3blocks/config

separator_block_width=0
interval=5

[Music]
command=~/.config/i3blocks/minimal/scripts-bash/music.sh
signal=15
markup=pango
separator=false

[CPU]
command=~/.config/i3blocks/minimal/scripts-c/cpu
interval=persist
markup=pango
separator=false

[Disk]
command=~/.config/i3blocks/minimal/scripts-bash/almacenamiento.sh
interval=120
markup=pango
separator=false

[Memory]
command=~/.config/i3blocks/minimal/scripts-c/ram
interval=5
markup=pango
separator=false

[time]
command=~/.config/i3blocks/minimal/scripts-bash/tiempo.sh
interval=60
markup=pango
separator=false

[Volume]
command=~/.config/i3blocks/minimal/scripts-bash/volume.sh
interval=once
signal=7
markup=pango
separator=false

[Power Off]
command=~/.config/i3blocks/minimal/scripts-bash/apagar-reboot-logout.sh
interval=once
markup=pango
separator=false
